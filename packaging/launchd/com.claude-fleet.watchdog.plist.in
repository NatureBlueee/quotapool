<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.claude-fleet.watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/share/claude-fleet/scripts/fleet-watchdog</string>
		<string>--quiet</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>StandardErrorPath</key>
	<string>@HOME@/.local/state/claude-fleet/watchdog.log</string>
</dict>
</plist>
