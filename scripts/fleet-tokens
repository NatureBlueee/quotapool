#!/usr/bin/env python3
"""Token consumption, read out of Claude Code's own transcripts.

The subscription API does not report tokens. `tokensLimit` / `tokensRemaining`
in the data plane's quota object are null on every account here — those fields
belong to API-key metering. What the subscription gives is a percentage of an
opaque window, which is what the rest of this fleet schedules on.

Claude Code does record real counts: every assistant message in
`~/.claude/projects/<project>/<session>.jsonl` carries a `usage` block. That is
the only place actual token numbers exist on this machine.

Two modes, deliberately split:

    fleet-tokens --collect     scan new bytes, update the rolling buckets
    fleet-tokens               print the summary from the buckets, instantly

The panel refreshes every 20 seconds and must not pay for a scan. `--collect`
runs on its own timer; the default read is a single small JSON file.

Scanning is incremental by byte offset. Full history is 5 GB across 4,585 files
here, so a full re-read is out of the question; only files that grew since the
last pass are touched, and only their new tail. First run bootstraps from the
last `--bootstrap-hours` of activity and skips to the end of everything older,
because reading months of history at once would produce a "cumulative" number
that means nothing.

CACHE READS ARE REPORTED SEPARATELY AND NOT IN THE TOTAL. Measured in one
session file: 127M cache reads against 924k output. Folding those into one
number would produce something dominated entirely by cache hits, which is the
opposite of consumption.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional

STATE = Path.home() / ".local" / "state" / "claude-fleet" / "token-state.json"
PROJECTS = Path.home() / ".claude" / "projects"
BUCKET_SECONDS = 60
KEEP_SECONDS = 25 * 3600          # a little over a day, so 24h windows stay whole
COUNTED = ("input_tokens", "output_tokens", "cache_creation_input_tokens")

# ─── Designed to run for years, not for a demo ────────────────────────────────
#
# Three things grow without bound unless something is done about each:
#
#   minute buckets   1,440/day. Rolled into daily totals once they age past
#                    KEEP_SECONDS, so this stays flat.
#   daily totals     365/year at ~60 bytes. Kept for ever — that IS the
#                    cumulative figure, and discarding it would mean "total
#                    consumed" could never mean anything but "today".
#   file cursors     one per transcript ever seen: 4,586 already, 584 KB, and
#                    the whole file is parsed on every collect. Pruned once a
#                    file is older than the sealed boundary.
#
# Pruning a cursor is only safe because of `sealed_before`: if a pruned file is
# somehow appended to later it gets re-read from zero, and every entry it
# yields falls before the boundary and is dropped. Without that, re-reading
# would double-count into days already rolled up.
DAY_SECONDS = 86400

# Bumped whenever the shape of `buckets` / `daily` changes. A mismatch discards
# the state and rebuilds, which is affordable precisely because scanning is
# cheap — 5 GB of history reads in tens of seconds.
SCHEMA = 4
UNKNOWN_MODEL = "unknown"

# ─── Deduplication is not optional ────────────────────────────────────────────
#
# Claude Code copies prior history into a new transcript when a session is
# resumed or forked, so the same assistant message appears in several files.
# Measured across the full history here: 382,472 entries carrying usage, only
# 166,661 distinct — 56.4% were duplicates. Counted naively the totals came out
# 2.3x higher than reality.
#
# The identity is (message.id, requestId), the same pair ccusage uses. Keys are
# stored hashed and short: full ids would make the state file an order of
# magnitude larger for no benefit, and 48 bits over ~10k live keys is far below
# any collision that matters.
#
# The key set lives and dies with its minute bucket. Nothing older needs to be
# remembered, because `sealed_before` already discards anything from a sealed
# period — a resumed session copying last week's messages produces entries with
# last week's timestamps, which are dropped before dedup is even consulted.
def _dedup_key(message_id: str, request_id: Optional[str]) -> str:
    import hashlib

    digest = hashlib.sha1(f"{message_id}|{request_id or ''}".encode("utf-8"))
    return digest.hexdigest()[:12]


def _load() -> Dict[str, Any]:
    try:
        data = json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        data = {}
    if data.get("schema") != SCHEMA:
        return {"schema": SCHEMA, "cursors": {}, "buckets": {}, "daily": {},
                "seen": {}, "sealed_before": 0.0, "bootstrapped": False}
    data.setdefault("cursors", {})
    data.setdefault("buckets", {})
    data.setdefault("daily", {})
    data.setdefault("seen", {})
    data.setdefault("sealed_before", 0.0)
    data.setdefault("bootstrapped", False)
    return data


def _save(state: Dict[str, Any]) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state), encoding="utf-8")
    tmp.replace(STATE)            # atomic, so a reader never sees half a file


def _bucket_of(stamp: Optional[str], fallback: float) -> int:
    """Bucket an entry by its own timestamp, not by when we happened to read it.

    A scan that runs a minute late must not pile a minute of work onto the
    instant it ran; that would turn every rate into a spike.
    """
    if stamp:
        try:
            moment = datetime.fromisoformat(stamp.replace("Z", "+00:00"))
            return int(moment.replace(tzinfo=moment.tzinfo or timezone.utc)
                       .timestamp() // BUCKET_SECONDS)
        except ValueError:
            pass
    return int(fallback // BUCKET_SECONDS)


def _scan_file(path: Path, offset: int, buckets: Dict[str, Any],
               sealed_before: float, seen: Dict[str, List[str]],
               live: set) -> int:
    """Read from `offset` to EOF, adding any usage found. Returns the new offset."""
    try:
        size = path.stat().st_size
    except OSError:
        return offset
    if size < offset:
        offset = 0            # truncated or replaced; start over rather than skip
    if size == offset:
        return offset
    try:
        with path.open("rb") as handle:
            handle.seek(offset)
            payload = handle.read()
    except OSError:
        return offset

    # Only the last complete line is safe to consume — a transcript being
    # written right now can leave a partial line at the end.
    end = payload.rfind(b"\n")
    if end < 0:
        return offset
    consumed = payload[:end + 1]
    mtime = path.stat().st_mtime

    for raw in consumed.split(b"\n"):
        # Cheap reject first: most lines are user turns and tool results with no
        # usage at all, and full JSON parsing of 700MB would not finish in time.
        if b'"usage"' not in raw:
            continue
        try:
            entry = json.loads(raw)
        except (ValueError, UnicodeDecodeError):
            continue
        usage = (entry.get("message") or {}).get("usage") or entry.get("usage")
        if not isinstance(usage, dict):
            continue
        stamp = _bucket_of(entry.get("timestamp"), mtime)
        if stamp * BUCKET_SECONDS < sealed_before:
            continue          # already rolled into a daily total; never twice
        # 按模型分开记。不分模型就没法定价 —— 一个 opus 的 output token 和一个
        # haiku 的差 15 倍，混在一起的总数乘任何单价都是错的。
        message = entry.get("message") or {}
        identifier = message.get("id")
        if identifier:
            key = _dedup_key(identifier, entry.get("requestId"))
            if key in live:
                continue      # same assistant message, copied into another file
            live.add(key)
            seen.setdefault(str(stamp), []).append(key)
        model = message.get("model") or UNKNOWN_MODEL
        # 五个量，不是四个：缓存写必须分 5 分钟和 1 小时两种 TTL。
        # 官方价差很大 —— 1h 写是基础价的 2 倍，5m 写是 1.25 倍。合成一个数就
        # 没法定价了，而实测这台机器上的写几乎全是 1h。
        detail = usage.get("cache_creation") or {}
        write_1h = int(detail.get("ephemeral_1h_input_tokens") or 0)
        write_5m = int(detail.get("ephemeral_5m_input_tokens") or 0)
        if not detail:
            # 老条目没有明细，只有合计。归到 5m（默认 TTL），并且不去猜。
            write_5m = int(usage.get("cache_creation_input_tokens") or 0)
        slot = buckets.setdefault(str(stamp), {}).setdefault(model, [0, 0, 0, 0, 0])
        slot[0] += int(usage.get("input_tokens") or 0)
        slot[1] += int(usage.get("output_tokens") or 0)
        slot[2] += write_5m
        slot[3] += write_1h
        slot[4] += int(usage.get("cache_read_input_tokens") or 0)

    return offset + len(consumed)


def collect(bootstrap_hours: float) -> Dict[str, Any]:
    state = _load()
    cursors: Dict[str, Any] = state["cursors"]
    buckets: Dict[str, List[int]] = state["buckets"]
    now = time.time()
    first_run = not state["bootstrapped"]
    sealed = float(state.get("sealed_before") or 0.0)
    seen: Dict[str, List[str]] = state["seen"]
    live = {key for keys in seen.values() for key in keys}
    scanned = skipped = 0

    if PROJECTS.is_dir():
        # 递归。实测 `*/*.jsonl` 只看到 4605 个文件，而递归能看到 6905 个 ——
        # 嵌套目录里还有 2300 个记录（子代理/侧链会话），漏掉它们会让 input
        # 少算三分之一。
        for path in PROJECTS.rglob("*.jsonl"):
            key = str(path)
            try:
                stat = path.stat()
            except OSError:
                continue
            known = cursors.get(key)
            if known is None:
                if stat.st_mtime < sealed:
                    # Untouched since the sealed boundary, so nothing in it can
                    # land after that boundary and everything it holds is
                    # already in a daily total. Skip it WITHOUT storing a
                    # cursor — that combination is what keeps the cursor map
                    # flat instead of growing with every transcript ever made.
                    #
                    # Getting this wrong is expensive and quiet: pruning the
                    # cursor while still re-reading the file turned a 0.10s
                    # incremental pass into 7.83s, every minute, for ever.
                    continue
                if first_run and now - stat.st_mtime > bootstrap_hours * 3600:
                    # Old and never seen: start at the end. Its history is real
                    # but it is not "recent consumption", and reading it would
                    # cost gigabytes for a number nobody asked for.
                    cursors[key] = stat.st_size
                    skipped += 1
                    continue
                known = 0
            new_offset = _scan_file(path, int(known), buckets, sealed,
                                    seen, live)
            if new_offset != known:
                scanned += 1
            cursors[key] = new_offset

    # Roll minutes past the retention line into days, then drop them. The daily
    # rows are what makes a cumulative total possible at all; keeping only
    # minutes means "total consumed" can never mean more than "today".
    daily: Dict[str, List[int]] = state["daily"]
    cutoff = int((now - KEEP_SECONDS) // BUCKET_SECONDS)
    for key in [k for k in seen if int(k) < cutoff]:
        del seen[key]         # same lifetime as its bucket, by construction
    for key in [k for k in buckets if int(k) < cutoff]:
        slot = buckets.pop(key)
        day = str(int(int(key) * BUCKET_SECONDS // DAY_SECONDS))
        target = daily.setdefault(day, {})
        for model, values in slot.items():
            row = target.setdefault(model, [0, 0, 0, 0, 0])
            for index in range(5):
                row[index] += values[index]

    # Everything before this instant is now accounted for in `daily`. Anything
    # re-read from that period must be discarded rather than added twice.
    state["sealed_before"] = max(
        float(state.get("sealed_before") or 0.0),
        (cutoff - 1) * BUCKET_SECONDS,
    )

    for key in list(cursors):
        try:
            if os.path.getmtime(key) < state["sealed_before"]:
                # Finished transcript: it cannot contribute anything that is not
                # already rolled up, so stop carrying a cursor for it.
                del cursors[key]
        except OSError:
            del cursors[key]      # gone; the projects directory churns constantly

    state["bootstrapped"] = True
    state["updated_at"] = now
    _save(state)
    return {"scanned": scanned, "skipped_old": skipped, "files": len(cursors)}


def summarise(state: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    state = state or _load()
    buckets: Dict[str, List[int]] = state.get("buckets") or {}
    daily: Dict[str, List[int]] = state.get("daily") or {}
    now = time.time()

    def _add(target: List[int], store: Dict[str, Any], keys) -> None:
        for key in keys:
            for values in (store.get(key) or {}).values():
                for index in range(5):
                    target[index] += values[index]

    def _fields(total: List[int]) -> Dict[str, int]:
        return {
            "input": total[0],
            "output": total[1],
            "cache_write_5m": total[2],
            "cache_write_1h": total[3],
            "cache_creation": total[2] + total[3],
            "cache_read": total[4],
            "counted": total[0] + total[1] + total[2] + total[3],
        }

    def window(seconds: float) -> Dict[str, int]:
        """A window spanning both stores.

        Anything inside KEEP_SECONDS is still in minute buckets; anything older
        has been rolled into days. A 7-day window has to read both or it reports
        only the tail — which is how a "cumulative" number silently becomes a
        "today" number.
        """
        total = [0, 0, 0, 0, 0]
        floor = (now - seconds) // BUCKET_SECONDS
        _add(total, buckets, [k for k in buckets if int(k) >= floor])
        day_floor = (now - seconds) // DAY_SECONDS
        _add(total, daily, [k for k in daily if int(k) >= day_floor])
        return _fields(total)

    everything = [0, 0, 0, 0, 0]
    per_model: Dict[str, List[int]] = {}
    for store in (buckets, daily):
        for slot in store.values():
            for model, values in slot.items():
                row = per_model.setdefault(model, [0, 0, 0, 0, 0])
                for index in range(5):
                    row[index] += values[index]
                    everything[index] += values[index]

    five = window(5 * 60)
    hour = window(3600)
    day = window(24 * 3600)
    return {
        "last_7d": window(7 * DAY_SECONDS),
        "last_30d": window(30 * DAY_SECONDS),
        # Since collection started, not since the account existed. The daily
        # rows are what make this mean anything more than "today".
        "total": _fields(everything),
        "by_model": {model: _fields(values) for model, values in per_model.items()},
        # 原始五元组 [input, output, 5m写, 1h写, 缓存读]，定价脚本按天取用。
        "daily_by_model": daily,
        "days_recorded": len(daily),
        "at": now,
        "updated_at": state.get("updated_at"),
        "bootstrapped": bool(state.get("bootstrapped")),
        # Per-minute over five minutes rather than one: a single minute with no
        # assistant turn in it reads as zero and makes the rate flicker.
        "per_minute": round(five["counted"] / 5, 1),
        "last_5m": five,
        "last_hour": hour,
        "last_24h": day,
    }


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(description="token consumption from transcripts")
    parser.add_argument("--collect", action="store_true",
                        help="scan new transcript bytes before printing")
    parser.add_argument("--bootstrap-hours", type=float, default=24,
                        help="on the very first run, how far back to read")
    parser.add_argument("--rescan-all", action="store_true",
                        help="discard state and read every transcript from the "
                             "beginning (whole history; tens of seconds)")
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args(argv)

    if args.rescan_all:
        try:
            STATE.unlink()
        except OSError:
            pass
        report = collect(float("inf"))
        print(json.dumps({**summarise(), "collect": report}, ensure_ascii=False))
        return 0

    if args.collect:
        report = collect(args.bootstrap_hours)
        if not args.quiet:
            print(json.dumps({**summarise(), "collect": report}, ensure_ascii=False))
        return 0

    print(json.dumps(summarise(), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
